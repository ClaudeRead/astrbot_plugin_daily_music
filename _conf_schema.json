{
  "schedule": {
    "description": "定时听歌",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用每日定时听歌",
        "type": "bool",
        "default": true
      },
      "windows": {
        "description": "听歌时间段",
        "type": "text",
        "default": "13:00-14:00\n18:00-21:00",
        "hint": "每行一个时间段，24 小时制，格式 13:00-14:00。每个时间段每天听一次，具体开始时刻在段内随机；可写多行，支持跨零点（如 23:00-01:00）"
      },
      "time": {
        "description": "（旧版）单点触发时间",
        "type": "string",
        "default": "",
        "hint": "仅当「听歌时间段」留空时作为兼容项生效，届时长 1 小时的窗口；建议直接用上面的时间段"
      },
      "timezone": {
        "description": "时区",
        "type": "string",
        "default": "Asia/Shanghai",
        "hint": "容器多为 UTC，默认按北京时间触发"
      }
    }
  },
  "listen": {
    "description": "听歌行为",
    "type": "object",
    "items": {
      "platforms": {
        "description": "听歌平台（按顺序尝试）",
        "type": "list",
        "default": ["qishui"],
        "options": ["qishui", "qq", "netease"],
        "labels": ["汽水音乐", "QQ音乐", "网易云"],
        "hint": "默认汽水音乐。每次只听其中一个平台：按列表顺序找歌，前一个平台没有可用歌曲时才换下一个"
      },
      "bot_choose": {
        "description": "让 Bot 按人格自选歌单主题",
        "type": "bool",
        "default": true,
        "hint": "开启后由大模型根据「性格设定」和当前时段生成搜索关键词，再在选定平台找歌；关闭则只用下面各平台配置的关键词/歌单"
      },
      "mode": {
        "description": "听歌量的计算方式",
        "type": "string",
        "default": "duration",
        "options": ["duration", "count"],
        "labels": ["按时长", "按首数"]
      },
      "duration_minutes": {
        "description": "本次听多久（分钟）",
        "type": "int",
        "default": 5,
        "slider": {"min": 3, "max": 60, "step": 1},
        "hint": "「按时长」时生效：按每首约 3.5 分钟折算成要听的歌曲数量"
      },
      "songs_per_day": {
        "description": "本次听几首",
        "type": "int",
        "default": 3,
        "slider": {"min": 1, "max": 12, "step": 1},
        "hint": "「按首数」时生效"
      },
      "listen_seconds": {
        "description": "每首歌记录听多久（秒）",
        "type": "int",
        "default": 180,
        "hint": "「按首数」时生效；写进听歌记录与听后感情境，不阻塞 Bot 运行"
      },
      "realtime_delay": {
        "description": "模拟真实听歌节奏",
        "type": "bool",
        "default": false,
        "hint": "开启后每首歌之间最多等待 15 秒，模拟真实听歌过程（默认关闭以快速完成）"
      },
      "history_size": {
        "description": "去重历史容量",
        "type": "int",
        "default": 200,
        "hint": "近期听过的歌不再重复选入"
      }
    }
  },
  "netease": {
    "description": "网易云来源",
    "type": "object",
    "items": {
      "playlist_id": {
        "description": "歌单 ID",
        "type": "string",
        "default": "",
        "hint": "网页版歌单链接中的 id 数字，如 3778678；留空则按 Bot 选的主题词搜索"
      },
      "keywords": {
        "description": "搜索关键词（兜底）",
        "type": "string",
        "default": "华语 流行 治愈",
        "hint": "没有歌单 ID 且 Bot 主题词搜不到歌时使用"
      }
    }
  },
  "qq": {
    "description": "QQ音乐来源",
    "type": "object",
    "items": {
      "playlist_id": {
        "description": "歌单 ID",
        "type": "string",
        "default": "",
        "hint": "网页版歌单链接 disstid 后的数字；留空则按 Bot 选的主题词搜索"
      },
      "keywords": {
        "description": "搜索关键词（兜底）",
        "type": "string",
        "default": "热门 华语",
        "hint": "没有歌单 ID 且 Bot 主题词搜不到歌时使用"
      }
    }
  },
  "qishui": {
    "description": "汽水音乐来源（无公开 API）",
    "type": "object",
    "items": {
      "song_list": {
        "description": "歌名列表",
        "type": "text",
        "default": "",
        "hint": "每行一首，格式「歌名 - 歌手」，如：起风了 - 买辣椒也用券。Bot 选的主题词会在这里做宽松过滤，没命中就听整个列表"
      },
      "api_url": {
        "description": "自定义接口地址",
        "type": "string",
        "default": "",
        "hint": "可选。返回 JSON 的 HTTP(S) 接口，格式 {\"songs\":[{\"name\":\"...\",\"artist\":\"...\"}]}，仅允许公网地址；可用 {keyword} 占位，会被替换成 Bot 选的主题词"
      }
    }
  },
  "llm": {
    "description": "大模型",
    "type": "object",
    "items": {
      "provider_id": {
        "description": "大模型提供商",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "从下拉列表里选择，留空则使用 AstrBot 全局默认提供商"
      },
      "model": {
        "description": "模型名（一般留空）",
        "type": "string",
        "default": "",
        "hint": "留空即使用所选提供商自己的默认模型（推荐）。只有需要在该提供商下指定子模型时才填，填错会触发 400"
      },
      "feeling_max_chars": {
        "description": "每句听后感字数上限",
        "type": "int",
        "default": 50,
        "hint": "越短越省 token"
      },
      "persona": {
        "description": "Bot 的性格设定",
        "type": "text",
        "default": "",
        "hint": "用于自选歌单主题、写听后感。会放在用户消息里而不是固定前缀，改它不会让提示词缓存整体失效"
      }
    }
  },
  "memory": {
    "description": "记忆写入（LivingMemory）",
    "type": "object",
    "items": {
      "enable": {
        "description": "把听歌记录与感受写入 LivingMemory",
        "type": "bool",
        "default": true,
        "hint": "未安装 astrbot_plugin_livingmemory 时自动回退保存到插件数据目录"
      },
      "importance": {
        "description": "记忆重要性",
        "type": "float",
        "default": 0.6,
        "slider": {"min": 0, "max": 1, "step": 0.05}
      },
      "topics": {
        "description": "记忆话题标签",
        "type": "string",
        "default": "听歌,音乐",
        "hint": "逗号分隔，平台名与当日主题词会自动追加"
      },
      "scope": {
        "description": "记忆作用域",
        "type": "string",
        "default": "livingmemory:global",
        "hint": "livingmemory:global 为全局；也可填具体会话 unified_msg_origin，让该会话的对话能召回这些记忆"
      }
    }
  },
  "notify": {
    "description": "结果通知",
    "type": "object",
    "items": {
      "sessions": {
        "description": "通知会话列表",
        "type": "list",
        "default": [],
        "hint": "定时听歌完成后推送结果摘要的会话 unified_msg_origin；可在会话里发「/listen 推送」快速添加"
      }
    }
  }
}
